<Window x:Class="JarvisTeto.ScreenAskOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid x:Name="RootGrid" Background="Transparent" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">

        <!-- Halo neón exterior (más difuso) -->
        <Border BorderThickness="14" IsHitTestVisible="False" Margin="4">
            <Border.BorderBrush>
                <SolidColorBrush Color="#2000D9FF"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect x:Name="OuterGlow" Color="#FF00D9FF" BlurRadius="80" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>
        </Border>

        <!-- Línea neón nítida sobre el borde -->
        <Border x:Name="GlowBorder" BorderThickness="3" IsHitTestVisible="False" Margin="4">
            <Border.BorderBrush>
                <SolidColorBrush Color="#FF00E5FF"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect x:Name="GlowEffect" Color="#FF00E5FF" BlurRadius="30" ShadowDepth="0" Opacity="0.9"/>
            </Border.Effect>
        </Border>

        <!-- Burbuja para preguntar / ver la respuesta -->
        <Border x:Name="Bubble" Background="#E6201A16" CornerRadius="18" BorderThickness="1.5"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Width="520" MinHeight="64" MaxHeight="260"
                Margin="0,0,0,70" Padding="20,16">
            <Border.BorderBrush>
                <SolidColorBrush Color="#FF00D9FF"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#FF00D9FF" BlurRadius="35" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="JARVIS" FontSize="10" FontWeight="Bold" Foreground="#FF6FE6FF"
                           Margin="0,0,0,6" Opacity="0.8"/>

                <Grid x:Name="InputRow">
                    <TextBlock x:Name="Placeholder" Text="Preguntale algo a Jarvis sobre tu pantalla..."
                               Foreground="#8A9AA5" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="14"/>
                    <TextBox x:Name="QuestionBox" Background="Transparent" Foreground="#F2E9E4" BorderThickness="0"
                             FontSize="14" CaretBrush="#FF00D9FF" VerticalAlignment="Center"
                             AcceptsReturn="False" TextChanged="QuestionBox_TextChanged"
                             PreviewKeyDown="QuestionBox_PreviewKeyDown"/>
                </Grid>

                <ScrollViewer x:Name="ResponseScroll" MaxHeight="180" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBlock x:Name="ResponseText" Foreground="#F2E9E4" TextWrapping="Wrap" FontSize="13.5"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>
