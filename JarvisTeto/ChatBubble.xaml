<Window x:Class="JarvisTeto.ChatBubble"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis"
        Width="300" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual">

    <Border Background="{StaticResource BgPanel}" CornerRadius="16"
            BorderBrush="{StaticResource BorderBlue}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" BlurRadius="26" ShadowDepth="3" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header chico -->
            <Grid Grid.Row="0" Margin="14,10,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBlueBright}" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FF00D9FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="JARVIS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI Semibold"/>
                    <TextBlock x:Name="StatusText" Text="  listo" FontSize="10" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" Margin="6,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#10005;" FontSize="11" Width="24" Height="24"
                        Style="{StaticResource GhostButton}" Click="Close_Click"/>
            </Grid>

            <!-- Chat -->
            <ScrollViewer Grid.Row="1" x:Name="ChatScroll" Padding="10,2" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3" Padding="9,6" CornerRadius="10"
                                    MaxWidth="220"
                                    HorizontalAlignment="{Binding IsUser, Converter={StaticResource AlignConverter}}"
                                    Background="{Binding IsUser, Converter={StaticResource BubbleColorConverter}}">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{Binding IsUser, Converter={StaticResource BubbleTextColorConverter}}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Input chico -->
            <Grid Grid.Row="2" Margin="10,6,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="MicButton" Grid.Column="0" Content="&#127908;" Style="{StaticResource IconToggle}"
                              Width="32" Height="32" FontSize="13" Margin="0,0,6,0" Click="MicButton_Click"/>

                <Border Grid.Column="1" Background="{StaticResource BgPanelLight}" CornerRadius="9"
                        BorderBrush="{StaticResource BorderBlue}" BorderThickness="1">
                    <TextBox x:Name="InputBox" Padding="8,6" FontSize="12"
                             Background="Transparent" Foreground="{StaticResource TextPrimary}"
                             BorderThickness="0" CaretBrush="{StaticResource AccentBlueBright}"
                             VerticalContentAlignment="Center"
                             AcceptsReturn="False" KeyDown="InputBox_KeyDown"/>
                </Border>

                <Button x:Name="SendButton" Grid.Column="2" Content="&#10148;" Style="{StaticResource RoundButton}"
                        Width="34" Height="32" FontSize="14" Margin="6,0,0,0" Click="SendButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
