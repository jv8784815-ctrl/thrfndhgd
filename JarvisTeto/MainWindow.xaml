<Window x:Class="JarvisTeto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:JarvisTeto.Controls"
        Title="Jarvis" Height="760" Width="460"
        Background="{StaticResource BgVoid}"
        WindowStartupLocation="Manual"
        Left="80" Top="80"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="16,12"
                BorderBrush="{StaticResource BorderBlue}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource AccentBlueBright}" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FF00D9FF" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="JARVIS" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" FontFamily="Segoe UI Semibold"/>
                    <TextBlock x:Name="StatusText" Text="  listo" FontSize="12" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" Margin="8,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#9881;" FontSize="16" Width="34" Height="34"
                        Style="{StaticResource GhostButton}" Click="Settings_Click"/>
            </Grid>
        </Border>

        <!-- La esfera de orbes: ocupa la parte más grande de la ventana a propósito -->
        <Border Grid.Row="1" Background="{StaticResource BgVoid}">
            <ctrl:OrbVisualizer x:Name="Orb" Margin="10"/>
        </Border>

        <!-- Chat -->
        <ScrollViewer Grid.Row="2" x:Name="ChatScroll" Padding="12,4" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource BgPanel}">
            <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="10,8" CornerRadius="12"
                                MaxWidth="300"
                                HorizontalAlignment="{Binding IsUser, Converter={StaticResource AlignConverter}}"
                                Background="{Binding IsUser, Converter={StaticResource BubbleColorConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{Binding IsUser, Converter={StaticResource BubbleTextColorConverter}}"/>
                                <TextBlock Text="{Binding Timestamp}" FontSize="9" HorizontalAlignment="Right" Margin="0,4,0,0"
                                           Foreground="{Binding IsUser, Converter={StaticResource BubbleTextColorConverter}}" Opacity="0.6"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Options row -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,6,12,6" Background="{StaticResource BgPanel}">
            <CheckBox x:Name="AttachScreenCheck" Content="Adjuntar pantalla" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Input row -->
        <Grid Grid.Row="4" Margin="12,0,12,12" Background="{StaticResource BgVoid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="MicButton" Grid.Column="0" Content="&#127908;" Style="{StaticResource IconToggle}"
                          Margin="0,0,6,0" Click="MicButton_Click"/>

            <Border Grid.Column="1" Background="{StaticResource BgPanelLight}" CornerRadius="10"
                    BorderBrush="{StaticResource BorderBlue}" BorderThickness="1">
                <TextBox x:Name="InputBox" Padding="10,8" FontSize="13"
                         Background="Transparent" Foreground="{StaticResource TextPrimary}"
                         BorderThickness="0" CaretBrush="{StaticResource AccentBlueBright}"
                         VerticalContentAlignment="Center"
                         AcceptsReturn="False" KeyDown="InputBox_KeyDown"/>
            </Border>

            <ToggleButton x:Name="ScreenButton" Grid.Column="2" Content="&#128421;" Style="{StaticResource IconToggle}"
                          Margin="6,0,6,0" IsChecked="{Binding ElementName=AttachScreenCheck, Path=IsChecked, Mode=TwoWay}"/>

            <Button x:Name="SendButton" Grid.Column="3" Content="&#10148;" Style="{StaticResource RoundButton}"
                    Width="42" Height="38" FontSize="16" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
